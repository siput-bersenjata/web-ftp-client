{
  "name": "web-ftp-client",
  "version": "1.0.0",
  "description": "Web-based Dual-Pane FTP Client with Local Storage & Quick Connect",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev:server": "node --watch server/server.js",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "basic-ftp": "^5.0.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fs-extra": "^11.2.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "ssh2-sftp-client": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
